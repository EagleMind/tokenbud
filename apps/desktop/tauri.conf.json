{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "tokenbud",
  "identifier": "dev.tokenbud.app",
  "build": {
    "frontendDist": "../../desktop/dist/app",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": {
      "script": "npm run dev:app",
      "cwd": "../../desktop",
      "wait": false
    },
    "beforeBuildCommand": {
      "script": "npm run build:app",
      "cwd": "../../desktop"
    }
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "url": "app.html",
        "title": "tokenbud",
        "width": 1040,
        "height": 720,
        "minWidth": 720,
        "minHeight": 560,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
