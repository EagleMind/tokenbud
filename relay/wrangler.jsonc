{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tokenbud-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "observability": { "enabled": true },
  "durable_objects": {
    "bindings": [{ "name": "HOSTS", "class_name": "HostRelay" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["HostRelay"] }],
  // Per-IP request limits, on top of the wrong-password limit each host keeps per caller.
  "ratelimits": [
    { "name": "REGISTER_LIMIT", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    { "name": "SESSION_LIMIT", "namespace_id": "1002", "simple": { "limit": 30, "period": 60 } }
  ],
  // The web client (built by `npm run build:web` in desktop/) is served at "/".
  // The API goes to the Worker first; everything else is the page.
  "assets": {
    "directory": "../desktop/dist/web",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/v1/*", "/health"]
  }
}
